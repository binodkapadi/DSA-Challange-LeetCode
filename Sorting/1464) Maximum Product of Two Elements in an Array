class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int n = nums.size();
        int max_num = nums[0];  // we assume here
        int product = 0;

        for(int i = 1; i < n; i++){
            product = max(product, (nums[i]-1) * (max_num-1));

            max_num = max(max_num, nums[i]);
        }
        return product;
    }
};
