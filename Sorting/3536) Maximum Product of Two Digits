------------------------------APPORACH 1[USING VECTOR AND SORTING]-----------------------

class Solution {
public:
    int maxProduct(int n) {

        vector<int> digits;
        while(n > 0){
            int rem = n % 10;
            digits.push_back(rem);
            n /= 10;
        }
        
        sort(begin(digits), end(digits));

        int max_product = 0;
        for(int i = digits.size()-1; i > 0; i--){
            max_product = max(max_product, digits[i] * digits[i-1]);
        }
        return max_product;
    }
};



------------------------------APPORACH 1[SIMPLE APPROACH BY FINDING LARGEST TWO DIGITS PRESENT IN THE NUMBER]-----------------------


class Solution {
public:
    int maxProduct(int n) {
        int largest = 0, secondLargest = 0;
        while(n > 0){
            int rem = n % 10;
            if(rem > largest){
                secondLargest = largest;
                largest = rem;
            }else if(rem > secondLargest){
                secondLargest = rem;
            }

            n /= 10;
        }

        return largest * secondLargest;
    }
};
