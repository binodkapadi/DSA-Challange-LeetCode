class Solution {
public:
    int memo[1001][1001];
    int solve(string &s, string &t, int m, int n){
        //Base Case
        if(n == 0)
            return memo[m][n] = 1;
        if(m == 0)
            return memo[m][n] = 0;

        if(memo[m][n] != -1)
            return memo[m][n];

        if(s[m-1] == t[n-1]){
            return memo[m][n] = solve(s, t, m-1, n-1) + solve(s, t, m-1, n);
        }else{
            return memo[m][n]= solve(s,t, m-1, n);
        }
    }
    int numDistinct(string s, string t) {
        memset(memo, -1, sizeof(memo));
        int m = s.length();
        int n = t.length();

        return solve(s, t, m, n);   
    }
};
