-------------------------APPROACH 1[cOUNTING THE FREQUENCY FIRST TEM BACKTRACKING]----------------------------

class Solution {
public:
    string lexGreaterPermutation(string s, string target) {
        int n = s.length();
        
        // 1. Map character frequencies for string 's'
        vector<int> count(26, 0);
        for (char c : s) {
            count[c - 'a']++;
        }

        // 2. Try to match the 'target' prefix as far as possible
        int match_len = 0;
        while (match_len < n && count[target[match_len] - 'a'] > 0) {
            count[target[match_len] - 'a']--;
            match_len++;
        }

        // 3. Backtrack from the maximum match length to find the first divergence point
        for (int i = match_len; i >= 0; i--) {
            // If we are at index i, it means we matched target up to index i - 1.
            // We now want to find a character for index i that is strictly greater than target[i]
            if (i < n) {
                char target_char = target[i];
                
                // Search for the smallest available character greater than target[i]
                for (int c = (target_char - 'a') + 1; c < 26; ++c) {
                    if (count[c] > 0) {
                        // Found a valid character! Let's construct the final string.
                        string result = target.substr(0, i);
                        result += (char)('a' + c);
                        count[c]--; // Use this character
                        
                        // Append all remaining characters from smallest to largest
                        for (int j = 0; j < 26; ++j) {
                            if (count[j] > 0) {
                                result += string(count[j], 'a' + j);
                            }
                        }
                        return result;
                    }
                }
            }
            
            // If we cannot find a valid greater character at index i, 
            // backtrack by returning target[i-1] back to the pool
            if (i > 0) {
                count[target[i - 1] - 'a']++;
            }
        }

        // Return empty string if no valid permutation is strictly greater than target
        return "";
    }
};


------------------------APPROACH 2[GENERAL APPROACH]--------------------------------------------

class Solution {
public:
    string lexGreaterPermutation(string s, string target) {

        // Count frequencies of each character (a-z)
        vector<int> count(26, 0);
        for (char c : s) {
            count[c - 'a']++;
        }

        int n = s.length();
        int m = target.length();
        string current_prefix = "";

        // We will track the best result found
        string best_res = "";

        //Iterate through all possible matching prefix lengths from 0 to min(n, m)
        for (int i = 0; i <= min(n, m); ++i) {
            if (i > 0) {
                char prev_char = target[i - 1];
                if (count[prev_char - 'a'] > 0) {
                    current_prefix += prev_char;
                    count[prev_char - 'a']--;
                } else {
                    // If s cannot match the target prefix up to this point, stop searching deeper
                    break;
                }
            }

            // Case A: The prefix matches the target fully, but s is longer.
            if (i == m) {
                if (n > i) {
                    string rem = "";
                    for (int c = 0; c < 26; ++c) {
                        rem += string(count[c], 'a' + c);
                    }
                    best_res = current_prefix + rem;
                }
                continue;
            }

            // Case B: Diverge here by picking a character strictly greater than target[i]
            char target_char = target[i];
            for (int c = (target_char - 'a') + 1; c < 26; ++c) {
                if (count[c] > 0) {
                    // Pick this slightly larger character
                    string rem = "";
                    rem += (char)('a' + c);
                    
                    // Consume it temporarily from the count pool
                    count[c]--;
                    
                    // Fill the absolute smallest remaining characters in sorted order
                    for (int j = 0; j < 26; ++j) {
                        if (count[j] > 0) {
                            rem += string(count[j], 'a' + j);
                        }
                    }
                    
                    // Put it back to keep count array accurate for subsequent loop steps
                    count[c]++; 
                    best_res = current_prefix + rem;
                    break; // Break the 'c' loop because we want the smallest character greater than target[i]
                }
            }
        }
        return best_res;
    }
};
