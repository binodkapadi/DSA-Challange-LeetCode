-------------------------APPROACH 1[USING UNORDERED MAP AND O(n) SPACE COMPLEXITY]-----------------------


class Solution {
public:
    int maximumLengthSubstring(string s) {
        int n = s.length();
        unordered_map<int, int> freq;

        int i = 0, j = 0;
        int result = 0;

        while(j < n){
            freq[s[j]]++;

            while(freq[s[j]] > 2){
                freq[s[i]]--;
                i++;
            }
            result = max(result, j-i+1);
            j++;
        }
        return result;
    }
};



-------------------------APPROACH 1[USING vectorof constant size AND O(1) SPACE COMPLEXITY]-----------------------


class Solution {
public:
    int maximumLengthSubstring(string s) {
        int n = s.length();
        vector<int> freq(26,0);

        int i = 0, j = 0;
        int result = 0;

        while(j < n){
            freq[s[j] - 'a']++;

            while(freq[s[j] - 'a'] > 2){
                freq[s[i] - 'a']--;
                i++;
            }
            result = max(result, j-i+1);
            j++;
        }
        return result;
    }
};
