class Solution {
public:
    int largestInteger(vector<int>& nums, int k) {
        int n = nums.size();
        int ans = -1;

        if (k == n) {
            int max_val = -1;
            for (int x : nums) 
                max_val = max(max_val, x);
            return max_val;
        }
        
        vector<int> count(51, 0);
        for (int x : nums) {
            count[x]++;
        }
        
        if (k == 1) {
            for (int i = 0; i <= 50; i++) {
                if (count[i] == 1) ans = i; // last one will be the largest
            }
            return ans;
        }
        
        // Check first element
        if (count[nums.front()] == 1) {
            ans = max(ans, nums.front());
        }
        // Check last element
        if (count[nums.back()] == 1) {
            ans = max(ans, nums.back());
        }    
        return ans;  
    }
};
