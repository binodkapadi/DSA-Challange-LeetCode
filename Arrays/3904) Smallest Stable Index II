class Solution {
public:
    int firstStableIndex(vector<int>& nums, int k) {
        int n = nums.size();
        vector<int> minFromIndex(n);
        int minEle = INT_MAX;
        int maxEle = INT_MIN;

        for(int i = n-1; i >= 0; i--){
            minEle = min(minEle, nums[i]);
            minFromIndex[i] = minEle;
        }
        for(int i = 0; i < n; i++){
            maxEle = max(maxEle, nums[i]);

            if(maxEle - minFromIndex[i] <= k){
                return i;
            }
        }
        return -1;
    }
};
