--------------------APPROACH 1 [USING TWO POINTER AND HASH MAP]------------------------------


class Solution {
public:
    int maxSubarrayLength(vector<int>& nums, int k) {
        int n = nums.size();
        unordered_map<int, int> freq;

        int i = 0, j = 0;
        int result = INT_MIN;

        while(j < n){
            freq[nums[j]]++;

            while(i < j && freq[nums[j]] > k){
                freq[nums[i]]--;
                i++;
            }
            result = max(result , j-i+1);
            j++;
        }
        return result;
    }
};
