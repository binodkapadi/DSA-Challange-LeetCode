class Solution {
public:
    bool sumGame(string num) {
        int n = num.length();

        int leftSum = 0;
        int rightSum = 0;
        int leftQuesCount = 0;
        int rightQuesCount = 0;

        for(int i = 0; i < n; i++){
            if(num[i] == '?'){
                if(i < n/2){
                    leftQuesCount++;
                }else{
                    rightQuesCount++;
                }
            }else{
                if(i < n/2){
                    leftSum += num[i] - '0';
                }else{
                    rightSum += num[i] - '0';
                }
            }
        }
        int total = leftQuesCount + rightQuesCount;

        if(total % 2 != 0){
            return true;
        }

        int LEFT = 2 * leftSum + 9 * leftQuesCount;
        int RIGHT = 2 * rightSum + 9 * rightQuesCount;

        return LEFT != RIGHT;

    }
};
