class Solution {
public:
    int minimumDeletions(vector<int>& nums) {
        int n = nums.size();
        auto minNum = *min_element(nums.begin(), nums.end());
        auto maxNum = *max_element(nums.begin(), nums.end());
        
        int minIdx, maxIdx;

        //find the indexes of min and max number
        for(int i = 0; i < n; i++){
            if(nums[i] == minNum)
                minIdx = i;
            else if(nums[i] == maxNum)
                maxIdx = i;
        }

        if(minIdx > maxIdx){
            swap(minIdx, maxIdx);
        }
        //delete both elements from the front
        int opt1 =  maxIdx + 1;

        //delete both from back
        int opt2 = n- minIdx;

        // delete one from front and one from back
        int opt3 =  (minIdx + 1) + (n - maxIdx);

        return min(opt1,min(opt2, opt3));   
    }
};
