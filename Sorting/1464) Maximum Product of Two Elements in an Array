class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int n = nums.size();

        sort(begin(nums), end(nums));

        int i = n-1;
        int j = n-2;

        int product = (nums[i] -1) * (nums[j] - 1);

        return product;   
    }
};


------------------APPROACH 2 ------------------------------------

class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int largest = 0, second_largest = 0;

        for(int &num: nums){
            if(num > largest){
                second_largest = largest;
                largest = num;
            }
            else if (num > second_largest){
                second_largest = num;
            }
        }

        int product = (largest-1) * (second_largest-1);

        return product;
    }
};



