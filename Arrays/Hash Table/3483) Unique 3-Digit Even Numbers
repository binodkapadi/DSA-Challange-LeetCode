class Solution {
public:
    int totalNumbers(vector<int>& digits) {
        unordered_map<int, int> digitscount;
        for(int d : digits){
            digitscount[d]++;
        }
        int uniqueEvenCount = 0;

        for(int n = 100; n <= 998; n+=2){
            int d1 = n / 100;
            int d2 = (n /10) % 10;
            int d3 = n % 10;

            unordered_map<int, int> required;
            required[d1]++;
            required[d2]++;
            required[d3]++;


            if(digitscount[d1] >= required[d1] && digitscount[d2] >= required[d2] && digitscount[d3] >= required[d3]){
                uniqueEvenCount++;
            }
        }
        return uniqueEvenCount;
    }
};
