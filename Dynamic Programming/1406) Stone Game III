class Solution {
public:
    int n; ///Global variable Decleration.
    vector<int> t;  //Memonization

    int solve(int i, vector<int>& stoneValue){
        int result = INT_MIN;

        if(i >= n)
            return 0;

        if(t[i] != -1)
            return t[i];
        
        result = max(result, (stoneValue[i] - solve(i+1, stoneValue)));

        if(i+1 < n)
            result = max(result, (stoneValue[i] + stoneValue[i+1] - solve(i+2, stoneValue)));

        if(i+2 < n)
            result = max(result, (stoneValue[i] + stoneValue[i+1] + stoneValue[i+2] - solve(i+3, stoneValue)));
        
        return t[i] = result;
    }
    string stoneGameIII(vector<int>& stoneValue) {
        n = stoneValue.size();
        t.resize(n+1, -1);

        int diff = solve(0, stoneValue);

        if(diff > 0){
            return "Alice";
        }else if(diff < 0){
            return "Bob";
        }else{
            return "Tie";
        }
    }
};
