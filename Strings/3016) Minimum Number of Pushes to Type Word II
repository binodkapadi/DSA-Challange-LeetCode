class Solution {
public:
    int minimumPushes(string word) {
        vector<int> fq_count(26,0);

        for(char &ch: word){
            fq_count[ch-'a']++;
        }
        sort(begin(fq_count), end(fq_count), greater<int>());  //For descending order short

        int result = 0;
        int initial_key = 2;
        for(int i = 0; i < 26; i++){
            if(initial_key > 9){
                initial_key = 2;
            }
            int freq = fq_count[i];
            int push = i/8 + 1;
            result += (freq * push);
            initial_key++;
        }
        return result;
    }
};
