#define ll long long
class Solution {
public:
    long long countCommas(long long n) {
       ll result = 0;
       ll start = 1000;

        while(start <= n){
           result += (n - start + 1);
           start *= 1000;
        }
        return result;
    }
};


---------------------------APPROACH 2-------------------------------------

#define ll long long
class Solution {
public:
    long long countCommas(long long n) {
        ll Count_comma = 0;
        ll comma_inrange = 1;
        ll lower = 1000;

        while(lower <= n){
            ll upper = lower * 1000 - 1;
            if(upper > n)
                upper = n;

            ll Count_num = upper - lower + 1;

            Count_comma += Count_num * comma_inrange;

            lower = lower * 1000;
            comma_inrange++;
        }
        return Count_comma;
    }
};

