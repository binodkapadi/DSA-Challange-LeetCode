class Solution {
public:
    int longestSubsequence(vector<int>& nums) {
        int n = nums.size();
        int xorvalue = 0;
        bool allzero = true;

        for(int i = 0; i < n; i++){
            xorvalue ^= nums[i];

            if(nums[i] != 0){
                allzero = false;
            }
        }
        if(allzero){
            return 0;
        }
        return (xorvalue == 0) ? n-1 : n;
    }
};
